{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maplesap",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "maplesap.app/*", "zone_name": "maplesap.app" },
    { "pattern": "www.maplesap.app/*", "zone_name": "maplesap.app" },
    { "pattern": "app.maplesap.app/*", "zone_name": "maplesap.app" },
    { "pattern": "lab.maplesap.app/*", "zone_name": "maplesap.app" }
  ]
}
